data{    array[155] int signups;    array[155] int typeid;}parameters{     vector[7] a;}model{     vector[155] lambda;    a ~ normal( 3 , 1 );    for ( i in 1:155 ) {        lambda[i] = a[typeid[i]];        lambda[i] = exp(lambda[i]);    }    signups ~ poisson( lambda );}generated quantities{    vector[155] log_lik;     vector[155] lambda;    for ( i in 1:155 ) {        lambda[i] = a[typeid[i]];        lambda[i] = exp(lambda[i]);    }    for ( i in 1:155 ) log_lik[i] = poisson_lpmf( signups[i] | lambda[i] );}