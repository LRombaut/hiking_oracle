data{    array[155] int signups;    array[155] int typeid;}parameters{     vector[7] a;     real<lower=0> phi;}model{     vector[155] lambda;    phi ~ exponential( 1 );    a ~ normal( 3 , 1 );    for ( i in 1:155 ) {        lambda[i] = a[typeid[i]];        lambda[i] = exp(lambda[i]);    }    signups ~ neg_binomial_2( lambda , phi );}generated quantities{    vector[155] log_lik;     vector[155] lambda;    for ( i in 1:155 ) {        lambda[i] = a[typeid[i]];        lambda[i] = exp(lambda[i]);    }    for ( i in 1:155 ) log_lik[i] = neg_binomial_2_lpmf( signups[i] | lambda[i] , phi );}